# Copiar como .env y completar. Nunca versionar .env.

# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# MongoDB
# En Docker, el host es el nombre del servicio (mongodb), no localhost
MONGODB_URI=mongodb://mongodb:27017/?directConnection=true
MONGODB_DB_NAME=bitacora

# CORS: dominios de las simulaciones y del tablero, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200
